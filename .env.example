# ─────────────────────────────────────────────────────────────────────────────
# LetsDoTogether API — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── Database (PostgreSQL + PostGIS) ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ldt_user
POSTGRES_PASSWORD=ldt_password
POSTGRES_DB=letsdotogether
# Full Prisma connection URL (takes precedence)
DATABASE_URL=postgresql://neondb_owner:npg_8gKOvdq9szkw@ep-cold-art-aym8mql4-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ldt_redis_pass
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING
JWT_REFRESH_EXPIRY=30d
JWT_EMAIL_VERIFY_SECRET=REPLACE_WITH_EMAIL_VERIFY_SECRET
JWT_EMAIL_VERIFY_EXPIRY=1h
JWT_PASSWORD_RESET_SECRET=REPLACE_WITH_PASSWORD_RESET_SECRET
JWT_PASSWORD_RESET_EXPIRY=1h

# ─── Email ───────────────────────────────────────────────────────────────────
# Provider: resend | sendgrid | smtp
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@letsdotogether.app
EMAIL_FROM_NAME=LetsDoTogether

# SMTP (for local dev with Mailhog or similar)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Resend (production recommended)
RESEND_API_KEY=re_REPLACE_ME

# SendGrid
SENDGRID_API_KEY=SG.REPLACE_ME

# ─── Cloudinary (Media Storage) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Provider: gemini | openai | none
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME

# ─── Payment (Razorpay abstraction) ──────────────────────────────────────────
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# ─── Rate Limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ─── Swagger ─────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_TITLE=LetsDoTogether API
SWAGGER_DESCRIPTION=Social activity and interest matching platform API
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Set to 'true' in development for pretty-printed logs
LOG_PRETTY=true
